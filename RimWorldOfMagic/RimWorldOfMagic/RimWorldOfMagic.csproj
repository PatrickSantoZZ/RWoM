<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RimWorld 1.7 (Waylith engine, .NET 10).
    Builds with the .NET 9 SDK: the framework references come from the game folder instead of a targeting pack.
    Set RimWorldDir / WorkshopDir if your Steam library is elsewhere:
      dotnet build -c Release -p:RimWorldDir=... -p:WorkshopDir=...
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>TorannMagic</RootNamespace>
    <AssemblyName>TorannMagic</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>..\..\v1.7\Assemblies\</OutputPath>
    <!-- Own folder, obj\Debug and obj\Release still hold old tracked files from the upstream build. -->
    <IntermediateOutputPath>obj\v1.7\</IntermediateOutputPath>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0169;CS0219;CS0414;CS0618;CS0649;CS0108;CS0114</NoWarn>

    <RimWorldDir Condition="'$(RimWorldDir)' == ''">F:\SteamLibrary\steamapps\common\RimWorld</RimWorldDir>
    <WorkshopDir Condition="'$(WorkshopDir)' == ''">F:\SteamLibrary\steamapps\workshop\content\294100</WorkshopDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Not part of the upstream build either (duplicate of CompProperties_AbilitySpawnDetailed). -->
    <Compile Remove="Ideology\CompProperties_AbilityDetailedSpawn.cs" />
    <Compile Remove="obj\**;bin\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Game -->
    <Reference Include="$(RimWorldDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(RimWorldDir)\UnityStubs.dll;$(RimWorldDir)\Waylith.dll" Private="false" />
    <Reference Include="$(RimWorldDir)\System*.dll" Exclude="$(RimWorldDir)\*.Native.dll" Private="false" />
    <Reference Include="$(RimWorldDir)\mscorlib.dll;$(RimWorldDir)\netstandard.dll;$(RimWorldDir)\Microsoft.CSharp.dll" Private="false" />

    <!-- Harmony (2009463077), JecsLite (3312959701), Humanoid Alien Races (839005762) -->
    <Reference Include="$(WorkshopDir)\2009463077\1.7\Assemblies\0Harmony.dll" Private="false" />
    <Reference Include="$(WorkshopDir)\3312959701\1.7\Assemblies\AbilityUser.dll" Private="false" />
    <Reference Include="$(WorkshopDir)\3312959701\1.7\Assemblies\AbilityUserAI.dll" Private="false" />
    <Reference Include="$(WorkshopDir)\3312959701\1.7\Assemblies\CompDeflector.dll" Private="false" />
    <Reference Include="$(WorkshopDir)\839005762\1.7\Assemblies\AlienRace.dll" Private="false" />
  </ItemGroup>
</Project>
